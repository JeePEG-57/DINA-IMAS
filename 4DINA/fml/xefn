C xefn [m#2/s]:	Experimental ion heat conductivity
C			(A.Polevoi 21-08-13) 
	YR=(J-.5)*HRO

	if (J .lt. NA) then
	xefn=G11(J)*(NI(J)*GRAD(TIX,J)+NE(J)*GRAD(TEX,J))
	else
	xefn =G11(J)*(NI(J)*GRAD(TIX,NA)+NE(J)*GRAD(TEX,NA))
	endif
	if(xefn.lt.-1.d-4) then 
    	xefn =(
     .    -625.* (QITOTR(YR)-QIDWTR(YR)+QETOTR(YR)-QEDWTR(YR))
     .    +(QNTOTR(YR)-QNDNTR(YR))*( Te(j)+Ti(j)*Ni(j)/NE(j))*2.5
     .    )/xefn
	else
	 xefn=0.d0
	endif
