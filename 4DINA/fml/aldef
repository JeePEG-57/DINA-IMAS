C----------------------------------------------------------------------|
C ALDEF []:	MHD alpha (r) defined as
C	CGS: \alpha_MHD = -2*R_0*[dp/d\rho]*4\pi[q/B]^2
C	SI:  \alpha_MHD = -2*mu_0*dp/dFP*dV/dFP*[V/2/R]^0.5/pi
C R.J.Groebner and T.H.Osborne, Phys.oo Plasmas, V.5, N5, May 1998
C	FP=psi/2/pi				(Polevoi 15-May-2012)
C----------------------------------------------------------------------|
	if (j .lt. NA)	then
	   ALDEF = (NE(j+1)*TE(j+1)-NE(j)*TE(j)
     >		   +NI(j+1)*TI(j+1)-NI(j)*TI(j))/HRO
	else
	   ALDEF = (NE(NA1)*TE(NA1)-NE(NA)*TE(NA)
     >	           +NI(NA1)*TI(NA1)-NI(NA)*TI(NA))/HROA
	endif
	ALDEF = -2.3d-5*ALDEF*((RTOR+SHIFT)/RTOR/BTOR/RHO(j)/MU(j))**2
     >		*VR(j)*sqrt(VOLUM(J)/(RTOR+SHIF(J)))

