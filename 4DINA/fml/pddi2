C PDDI2	 D-D Fraction of fusion p(3.025 MeV) power deposited to ions
C D.E.Post, 'Applied Atomic Collision Physics, Vol 2, 381, (1984)
C  Polevoi 8-JUN-07
C	Pdde = svd2*NDEUT*NDEUT*3025./625.*(1-pddi1)
C	Pddi = svd2*NDEUT*NDEUT*3025./625.*pddi1
C			(used in PDDe, PDDi)

      YEPS=3025./10./TE(J)
	YEPS=DSQRT(YEPS)
      PDDI2=2.0d0/YEPS**2*(0.57735*atan(0.57735*(2.0d0*YEPS-1.0d0))
     +            -0.16667*log((1.0d0+YEPS)**2/(1.0d0-YEPS+YEPS**2))
     +            +0.302299894d0 )
