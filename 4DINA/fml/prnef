C PRNEf [MW*m#3] Neon radiation power
C T [eV] Electron temperature
C       POST D.E. JENSEN R.V. e.a., Atomic Data and Nuclear Tables,
C				    Vol.20 (1977) 397.
C				(L.Giannone 06-08-96)
C	Correted for low T by Putvinski/Kukushkin (T< 20 eV)
C	Usage:		PE=...-PRNEO*NE*NIZ1
        T=TE(J)
	if(j.gt.1) then 
		PRNEF=Pneoff(TE(j),TE(j-1))
	else
		PRNEF=Pneoff(TE(j),TE(j))
	endif
        
