C PDDI3	 D-D Fraction of fusion 3He(870 keV) power deposited to ions
C D.E.Post, 'Applied Atomic Collision Physics, Vol 2, 381, (1984)
C  Polevoi 8-JUN-07
C	Pdde = svd1*NDEUT*NDEUT*870./625.*(1-pddi3)
C	Pddi = svd1*NDEUT*NDEUT*870./625.*pddi3
C			(used in PDDe, PDDi)

      YEPS=870./30./TE(J)
	YEPS=DSQRT(YEPS)
      PDDI3=2.0d0/YEPS**2*(0.57735*atan(0.57735*(2.0d0*YEPS-1.0d0))
     +            -0.16667*log((1.0d0+YEPS)**2/(1.0d0-YEPS+YEPS**2))
     +            +0.302299894d0 )
