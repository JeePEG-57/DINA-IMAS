C PRTUN [MW*m#3] tungsten radiation power
C       POST D.E. JENSEN R.V. e.a., Atomic Data and Nuclear Tables,
C				    Vol.20 (1977) 397.
C	(PPPL-1352 1977)
C				(Yushmanov 27-12-89)
C	Corrected by Pereverzev 29-07-96
C	Usage:		PE=...-PRWOL*NE*NIZ1
	T=1.d3*TE(j)
	Z=      LOG10(TE(J))
        IF(T.LE.333.)                Y=0.3-.18
        IF(333.LE.T.AND.T.LE.1.E3)   Y=0.6-1.32*Z**2-.18
	if(Z.gt.0..and.Z.le.0.043) 	Y=0.42
	if(Z.gt.0.043.and.Z.le.0.12) Y=0.42-1.169*(Z-0.043)
	if(Z.gt.0.12.and.Z.le.0.19) Y= 0.33
	if(Z.gt.0.19.and.Z.le.0.3) Y= .33+1.455*(Z-0.19)
	if(Z.gt.0.3.and.Z.le.0.387) Y= .49
	if(Z.gt.0.387.and.Z.le.0.47) Y= .49-1.325*(Z-0.387)
	if(Z.gt.0.47.and.Z.le.0.6) Y= .38-1.385*(Z-0.47)
	if(Z.gt.0.6.and.Z.le.0.68) Y=.2-2.25*(Z-0.6)
	if(Z.gt.0.68.and.Z.le.0.84) Y= .02
	if(Z.gt.0.84.and.Z.le.0.967) Y= .02-.866*(Z-0.84)
	if(Z.gt.0.967.and.Z.le.1.11) Y= -.09-.629*(Z-0.967)
	if(Z.gt.1.11.and.Z.le.1.29) Y= -.18-.5*(Z-1.11)
	if(Z.gt.1.29)  Y=-.27
	y=y+1.
	PRTUN	=10.**Y
