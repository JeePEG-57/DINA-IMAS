C CCMHD1  [1/mkOhm*m] or [MA/V*m]: Conductivity anomalous due to
C		sawtooth oscillations (q<1)	(G.Pereverzev 31-01-06)
C	CC=Const inside q<1, CC is unchanged elsewhere
C Conductivity is artificially enhanced in order to keep q above 1
C			Usage example:	CC=CNHR+CCMHD1
	if (j.eq.NA1)	call MIX1('CC',9.2d-1)
	CCMHD1	=0.
