C S3HDD [10^-19m^3]:	The formula is a fit to suprathermal T
C	from  D-D reaction rate in DD plasma
C	according to Putvinskiy
C	d+d=3He(870 keV)+n(2.45 MeV)
C	nfast = S*tauS*ln(1+(Vb/Vc)**3)/3
C	tauS = 0.117*Afast*Te^1.5/ne
C	Use: nfast = Nd*Nd*s3hdd 	[10^19m-3]
C			(Polevoi 07-JUN-07)
	include 'fml/svd1'
	s3hdd=870./3./(10.*TE(J)+1.e-7)
	s3hdd=svd1*0.117*TE(J)*sqrt(TE(J))/(NE(J)+1.e-7)*
     *	LOG(1.+s3hdd*sqrt(s3hdd)*5./6.)	
