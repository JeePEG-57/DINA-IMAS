C PEICZ [MW/m#3/keV]: Electron ion heat exchange due to Coulomb collisions
C	PEI=3/tauei*Ne*m/M	take account for impurities.
C	here tauei=(7.3E-8)*Te#(3/2)/(Z#2*Ni) [c]
C	PE=...+PEI*TI;		PET=...-PEI
C	PI=...+PEI*TE;		PIT=...-PEI
C			(Leonov 30-05-97)
	PEICZ	=0.0367*NE(J)*(TE(J)-TI(J))/(TE(J)*SQRT(TE(J)))*
     *		(NHYDR(J)+NDEUT(J)/2.+NTRIT(J)/3.+NALF(J)+
     +		NIZ1(J)*ZIM1(J)**2/AIM1+NIZ2(J)*ZIM2(J)**2/AIM2+
     +          NIZ3(J)*ZIM3(J)**2/AIM3)
