C PAION3	 D-T Fraction of fusion alpha power deposited to ions
C D.E.Post, 'Applied Atomic Collision Physics, Vol 2, 381, (1984)
C C.M.Roach, 5/7/99 (modified by I.A. Vojtsekhovich 12.07.99)
      YVALP=1.2960e+07
      YVE=SQRT(2.0*TE(J)*1.7564e+14)
      YLLAME=23.9+LOG(1.e3*TE(J)/SQRT(1.e19*NE(J)))
      YY5=SQRT(1.e3*TE(J)/1.e19*NE(J))
      YY6=YY5*(4.*AMAIN(J)*YVALP)/(4.+AMAIN(J))      
		if(YY6.lt..1)YY6=0.1
       YLLAMI=14.2+LOG(YY6)
       YY7=SQRT(1.0e3*TE(J)/1.0e19*NE(J))*2.0*YVALP
		if(YY7.lt..01)YY7=.01
      YLLAMA=14.2+LOG(YY7)
	YY1=YLLAMI*NI(J)/(AMAIN(J)*NE(J))
	YY2=7.3e-4/YLLAME*(YY1+YLLAMA*NALF(J)/NE(J))
	
		if(YY2.lt.0.0001)YY2=.0001
	YVC=YY2**0.33*YVE
      YEPS=YVALP/(YVC+0.0001)
	Y2=YEPS*YEPS
      YY3=atan(0.577*(2.*YEPS-1.))       
      YY4=log((1.+YEPS)**2/(1.-YEPS+YEPS**2))
C      PAION3=2./YEPS**2*(0.577*YY3-0.167*YY4+0.3)
        PAION3=2.*(0.166666667*LOG((1-YEPS+y2)/(1.+2.*YEPS+y2))+
     + 0.57735026*(ATAN( 0.57735026*(2.*YEPS-1.) )+0.52359874) ) / y2
