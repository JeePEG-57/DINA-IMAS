C P3DD [10^-19m3]:	The formula is a fit to suprathermal hydrogen
C	density from  D-D reaction rate in DD plasma
C	according to Putvinskiy
C	d+d=t(1.008MeV)+p(3.025MeV)
C	nfast = S*tauS*ln(1+(Vb/Vc)**3)/3
C	tauS = 0.117*Afast*Te^1.5/ne
C	Use: nfast = Nd*Nd*svd2*p3dd 	[10^19m-3]
C			(Polevoi 07-JUN-07)
C	include 'fml/svd2'
	p3dd=3025./(10.*TE(J)+1.e-7)
	p3dd=0.117*TE(J)*sqrt(TE(J))/(NE(J)+1.e-7)*
     *	dLOG(1.+p3dd*sqrt(p3dd)*5./6.)/3.	
