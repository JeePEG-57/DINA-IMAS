C CALPHA [norm to DALPHA]:	Anomalous Convection of ALPHA particles
C usage VF_j = DHE*DALPHA*CALPHA
cla			25.07.08
	CALPHA=(105.9/TE(J))**1.5
	CALPHA=1.5/(log(CALPHA+1.)*(1.+1./CALPHA))-1.5
        if (J .lt. NA) then
            CALPHA=-2*CALPHA*(TE(J+1)-TE(J))/HRO/(TE(J+1)+TE(J))
        else
            CALPHA=-2*CALPHA*(TE(NA1)-TE(NA))/HROA/(TE(NA1)+TE(NA))
        endif

