C CTHE [Thermodiffusion coefficient for flux of He in 1/m]
C usage VF_j = DHE*CTHE + DHE*CPHE
cla			25.07.08
	CTHE=2.3*(RHO(J)/ROC)**3-4.2*(RHO(J)/ROC)**2
        CTHE=CTHE+1.5*(RHO(J)/ROC)+0.2
        if (J .lt. NA) then
            CTHE=-2*CTHE*(TI(J+1)-TI(J))/HRO/(TI(J+1)+TI(J))
        else
            CTHE=-2*CTHE*(TI(NA1)-TI(NA))/HROA/(TI(NA1)+TI(NA))
        endif

