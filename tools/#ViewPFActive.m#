function [a]= ViewPFActive(shot, run)
% Check arguments
if (nargin ~=2)
    error('Bad number of input arguments. (Must be 2: numShot, run)');
end
addpath /work/imas/projects/ual/2.0/matlabinterface;

expIdx = imas_open('ids', shot, run);
a=ids_get(expIdx, 'pf_activei/1:OA');
imas_close(expIdx,'ids',shot,run);
%
disp('get_pf_active results:');
disp('ids_properties:');
disp(a.ids_properties);


% View coils information
[dim1] = length(a.coil);
disp(['coil size = ' num2str(dim1)]);
for i=1:dim1 
    
    a.coil{i}.name
    a.coil{i}.identifier
    a.coil{i}.resistance
    
    dim2 = length(a.coil{i}.current.data);
    disp(['-coil(' num2str(i) ').current.data size = ' num2str(dim2)]);
    a.coil{i}.current.data
    a.coil{i}.current.time   
    dim2 = length(a.coil{i}.voltage.data);
    disp(['-coil(' num2str(i) ').voltage.data size = ' num2str(dim2)]);
    a.coil{i}.voltage.data
    a.coil{i}.voltage.time
   
end


a.code


dim1 = length(a.time);
disp(['time size = ' num2str(dim1)]);
a.time

%
end