C SVIE [10#19m#3/s]: The formula is a fit to ionization rate by electron impact
C	Freeman R.L.,Jones E.M., CLM-R137 (1974)
C			(Pereverzev 07-MAY-87)
	SVIEj	=LOG10(TE(J))+3
	IF(TE(J).GT..02)	THEN
	SVIEj=EXP(17.68-1.186*SVIEj-5.9015/SVIEj)
				ELSE
	SVIEj=EXP(29.93-7.0321*SVIEj-36.2*EXP(-SVIEj)+3.691*EXP(-SVIEj**2))
				ENDIF

