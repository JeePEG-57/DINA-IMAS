C SVDHE [10#19m#3/s]:	The formula is a fit to D-3He reaction rate
C	according to Golovin (Preprint IAE-4885/8 1989)
C	D+3He=alpha(3.671MeV)+p(14.683MeV)
C	Use:	Palpha=Nd*N3He*SVDHe*18354./625. [MW/m#3]
C	Ti<100 KeV		(Polevoy 18-MAY-90)
	SVDHE	=LOG10(TI(J))
	IF(TI(J).LE.18.5d0)	THEN
		Y=4.393*(SVDHE-1.16d0)
				ELSE
	IF(TI(J).LE.25.)Y=0.47d0+3.985d0*(SVDHE-1.267d0)
				ENDIF
	IF((TI(J).GT.25.).AND.(TI(J).LE.40.))Y=1.d0+3.d0*(SVDHE-1.4d0)
	IF((TI(J).GT.40.).AND.(TI(J).LE.60.))Y=1.6+1.944*(SVDHE-1.6d0)
	IF(TI(J).GT.60.)Y	=1.95d0+1.136d0*(SVDHE-1.78d0)
      	SVDHE =10.**(Y-5.d0)
