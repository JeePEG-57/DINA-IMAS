C	Fusion power in alphas from 1 MeV D NBI and T cold target
C	approximation of cold Tritium (Ti = 0) DT (50:50 plasmas)
C 
C	crossection by	S.V.Putvinskij//VANT,v.2,1988,p.3
C	Corrected by S.V.Putvinskij 22.11.89
C	Use:		Pd1bt = Pbeam*sd1bt	[MW/m#3] 
C  		 D-T	Fusion power cold T  + 1.00 MeV D fast
C	
C				Polevoy		06-JUL-99,08-JUN-07
c	ABEAM = 2.
c	EBEAM = 1000.
	
C.......Logarithm e
c	YLE	=15.85+LOG(TE(J)/SQRT(NE(J)))
c	2 TauES = 2.d0*ABEAM)*TE(J)^1.5/LnE/NE(J
c	V0	=
c	IF(ABEAM.eq.2)	then
c		YECM	=0.6*EBEAM
		YECM	=600.d0
		YSQ	=SQRT(YECM)
		YJ	=Y*NTRIT(J)

c	endif

 		YS	=0.d0
		sd1bt	=0.d0

c	  YECDEB =14.6*TE(J)*ABEAM/(Ai)**(2/3)/EBEAM
	  YECDEB  = 14.6d0*TE(J)*2.d0/1000.d0/(AMAIN(1))**0.667
	  YXC3 =YECDEB*SQRT(YECDEB)
	DO 	JK = 1,999
	YX	=.001*JK
	YX2	=YX*YX
	YX3	=YX2*YX
	YE	=YECM*YX2
	YS2	=(YE-48.7878)**2
	YSIG	=EXP(-34.3812/YX/YSQ)*(1.+1.1177E-5*YS2)/
     /			(1.+6.433E-4*YS2)/YE
      		sd1bt	=sd1bt+ YSIG/(1.+YXC3/YX3)
	 enddo
	sd1bt	=sd1bt*26798.d0*.001d0*NTRIT(J)*3520.d0*
     * 	4.38d-4/DSQRT(1000.d0*2.d0)*
     *	2.d0*2.d0/NE(J)*TE(J)*DSQRT(TE(J))/
     /	(15.85d0+DLOG(TE(J)/DSQRT(NE(J))))
