C	stbrn[a.u.]
C	Fprb, Probability fro 1.008 MeV T NBI to burn out on D target 
C	approximation of cold Deuterium (Ti = 0) DT (50:50 plasmas)
C	crossection by S.V.Putvinskij//VANT,v.2,1988,p.3
C	Corrected by S.V.Putvinskij 22.11.89
C	Use:		Fprb = stbrn*Nd	[1/m#3] 
C  		 D-T	Fusion power thermal D  + 1.008 MeV T fast
C	
C				Polevoy		06-JUL-99,08-JUN-07
c	ABEAM = 3.
c	EBEAM = 1008.
C.......Logarithm e
c	YLE	=15.85+LOG(TE(J)/SQRT(NE(J)))
c	Y	=3.1E-4*(17590./SQRT(EBEAM))*2.*sqrt(ABEAM)
c	Y	=3.1E-4*(17590./SQRT(1008.))*2.*3.
c	IF(ABEAM.eq.3)	then
c		YECM	=0.4*EBEAM
		YECM	=1008.d0*.4d0
		YSQ	=DSQRT(YECM)
c	endif
		stbrn	=0.d0
c	  YECDEB =14.6*TE(J)*ABEAM/(Ai)**(2/3)/EBEAM
!!	YECDEB=EBDEC(1008.d0,3.d0,J)
!!	if(YECDEB.gt.0.d0) then
!!	YECDEB =1.d0/YECDEB
	  YECDEB  = 14.6d0*TE(J)*3.d0/1008.d0/(AMAIN(1))**0.667
	
	  YXC3 =YECDEB*DSQRT(YECDEB)
	DO 	Jk = 1,1000
	YX	=(1.d-3*Jk)
	YX2	=YX*YX
	YX3	=YX2*YX
	YE	=YECM*YX2
	YS2	=(YE-48.7878d0)**2
	YSIG	=DEXP(-34.3812d0/YX/YSQ)*(1.d0+1.1177d-5*YS2)/
     /			(1.d0+6.433d-4*YS2)/YE
      		stbrn	=stbrn+ YSIG/(1.d0+YXC3/YX3)
	 enddo
	stbrn	=stbrn*26798.d0*1.d-3*
     * 	4.38d-4*DSQRT(1008.d0/3.d0)*
     *	2.d0*3.d0/NE(J)*TE(J)*DSQRT(TE(J))/
     /	(15.85d0+DLOG(TE(J)/DSQRT(NE(J))))
!!	endif

 
