F90_gfortran=gfortran
COPTS_gfortran = -O0 -fdefault-real-8 -fPIC -fno-second-underscore -ffree-line-length-none -I$(UAL)/fortraninterface/amd64_gfortran -g  
LIBS_gfortran=-L$(UAL)/fortraninterface -lUALFORTRANInterface_gfortran -Wl,-rpath,$(UAL)/itmcatalog/lib -L$(UAL)/lowlevel -lUALLowLevel -lm

dir_v96=./


TARGETS += test_dina dina_imas.a dina_contr.a 

LIB_SOURCE1 += dina_imas.o n_dina_imas3.o

LIB_SOURCE2 += dina_contr.o n_kav.o

#SCHEMAS = /work/imas/projects/ual/2.0/fortraninterface/ids_schemas.f90

all: $(TARGETS)
	

#--------------------- gfortran ------------------------

test_dina: test_dina_imas.o dina_contr.o n_kav.o n_dina_imas3.o dina_imas.o dina_99.a dina_kav.a
	@echo "   * $^ -> $@"
	$(F90_gfortran) -o $@ $^ $(LIBS_gfortran)
		

%.o: %.f90
	@echo "   * $^ -> $@"
	$(F90_gfortran) $(COPTS_gfortran) -c -o $@ $^

n_dina_imas3.o: n_dina_imas3.f
	$(F90_gfortran) $(COPTS_gfortran) -c n_dina_imas3.f

n_kav.o: n_kav.f
	$(F90_gfortran) $(COPTS_gfortran) -c n_kav.f

dina_imas.a: $(LIB_SOURCE1)
	ar -rcs dina_imas.a n_dina_imas3.o dina_imas.o dina_99.a

dina_contr.a: $(LIB_SOURCE2)
	ar -rcs dina_contr.a dina_contr.o n_kav.o dina_kav.a
 


clean:
	rm *.o
	rm test_dina
	rm dina_imas.a
