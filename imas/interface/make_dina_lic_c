F90_gfortran=gfortran
COPTS_gfortran = -O0 -fdefault-real-8 -fPIC -fno-second-underscore -ffree-line-length-none -I$(UAL)/fortraninterface/amd64_gfortran -g  
LIBS_gfortran=-L$(UAL)/fortraninterface -lUALFORTRANInterface_gfortran -Wl,-rpath,$(UAL)/itmcatalog/lib -L$(UAL)/lowlevel -lUALLowLevel -lm

dir_v96=for/


TARGETS +=  dina_imas.a dina_contr.a dina_put_slice.a out42_for.o n_dina_imas3.o dina_put_slice.o 

LIB_SOURCE1 += dina_imas.o n_dina_imas3.o out42_for.o

LIB_SOURCE2 += dina_contr.o 

LIB_SOURCE3 += dina_put_slice.o

#SCHEMAS = /work/imas/projects/ual/2.0/fortraninterface/ids_schemas.f90

all: $(TARGETS)
	

#--------------------- gfortran ------------------------
test_dina: test_dina_imas.o dina_contr.o n_dina_imas3.o out42_for.o dina_imas.o 


%.o: %.f90
	@echo "   * $^ -> $@"
	$(F90_gfortran) $(COPTS_gfortran) -c -o $@ $^

n_dina_imas3.o: $(dir_v96)n_dina_imas3.f 
	$(F90_gfortran) $(COPTS_gfortran) -c $(dir_v96)n_dina_imas3.f


dina_contr.o: dina_contr.c
	g++ -fpic -c dina_contr.c


out42_for.o: out42_for.f
	$(F90_gfortran) $(COPTS_gfortran) -c out42_for.f

dina_imas.a: $(LIB_SOURCE1)
	@echo "   * $^ -> $@"
	@cp dina_99.a dina_imas.a
	ar -rcs dina_imas.a n_dina_imas3.o dina_imas.o 

dina_put_slice.a: $(LIB_SOURCE3)
	@echo "   * $^ -> $@"
	ar -rcs dina_put_slice.a dina_put_slice.o

dina_contr.a: $(LIB_SOURCE2)
	@echo "   * $^ -> $@"
	@cp dina_kav.a dina_contr.a
	ar -rcs dina_contr.a dina_contr.o 
 

clean:
	rm *.o
	rm test_dina
	rm dina_imas.a
