# Makefile for compilation of DINA components

AR ?= ar
ARFLAGS ?= -ru
FC ?= gfortran

CC ?= cc -fpic

FFLAGS ?= -w -ffixed-line-length-none -fd-lines-as-comments -fno-automatic -fPIC

DINASRC = a_dina_cir.f gen.f n_circ.f obrm.f out42_for.f

DINAOBJ = $(DINASRC:.f=.o)


all: dina_circ.a 

dina_circ.a: $(DINAOBJ)
	$(RM) -r dina_circ.a
	$(AR) $(ARFLAGS) $@ $(DINAOBJ)


%.o: %.f
	$(FC) $(FFLAGS) -c $<

%.o: %.c
	$(CC)  -c $<


clean:
	-rm -f *.o

distclean:
	-rm -f *.o *.a

