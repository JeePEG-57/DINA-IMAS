# Makefile for compilation of DINA components

AR?=ar
ARFLAGS?=-ru
FC?=gfortran

FCFLAGS=-fPIC -w
# COMPILER-SPECIFIC FLAGS
ifeq ($(FC), ifort)
  FCFLAGS+=-extend-source -nod-lines -save -init=zero -real-size 64
else ifeq ($(FC), gfortran)
  FCFLAGS+=-ffixed-line-length-none -fd-lines-as-comments -fno-automatic -freal-4-real-8
else
  $(error Unsupported Fortran compiler)
endif


DEBUG = -g -O0 -ffixed-form -fno-inline
ifeq ($(TARGET), DEBUG)
  FCFLAGS += $(DEBUG)
else ifeq ($(TARGET), OPTI)
  FCFLAGS += -O2 -march=native -funroll-loops -ffixed-form -fno-inline
endif


DINASRC = a_dina_cir.f gen.f n_circ.f obrm.f out42_for.f

DINAOBJ = $(DINASRC:.f=.o)


all: dina_circ.a 

dina_circ.a: $(DINAOBJ)
	$(RM) -r dina_circ.a
	$(AR) $(ARFLAGS) $@ $(DINAOBJ)

%.o: %.f
	$(FC) $(FCFLAGS) -c $<

clean:
	-rm -f *.o

distclean:
	-rm -f *.o *.a

